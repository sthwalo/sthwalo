PORT=4000
FRONTEND_URL=http://localhost:5173

DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=sthwalo

# Signs the admin session cookie. Must be >= 32 characters or every admin
# request fails. Generate with: openssl rand -base64 48
ADMIN_SESSION_SECRET=

# Contact-form notification email.
SMTP_USER=no-reply@sthwalo.com
NOTIFY_TO=you@example.com

# NOTE: index.js does NOT load dotenv. This file is read only by the CLI
# scripts (seed-posts.js, create-admin.js). The running API takes its
# environment from the process — on cPanel that means the Node.js app's
# "Environment variables" panel, not this file.
