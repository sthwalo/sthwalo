# Front-end build configuration. Copy to .env — that file is gitignored.

# Relative on purpose, and it matters.
#
# The API is same-origin under /api in every environment: sthwalo.com/api in
# production, localhost:8443/api in the Docker harness. A relative base means
# ONE bundle works in both. With an absolute production URL compiled in, the
# bundle you test locally can never be the bundle you ship — it would need a
# different build to reach a local API.
#
# All three consumers just concatenate onto this:
#   src/pages/Contact.tsx, src/utils/adminApi.ts, src/hooks/useBlogPosts.ts
VITE_API_URL=/api
