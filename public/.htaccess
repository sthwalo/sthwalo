# Never expose directory listings
Options -Indexes

# Prerendered pages are served at their own path; see the rules below.
DirectorySlash Off

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # /fin/* -> aosfin.com. FIN used to be a guest in this site's /fin/ subdirectory; it has its own
  # domain now, with the app at the apex. $1 carries the rest of the path, so a bookmark or an
  # emailed deep link lands on the page it named rather than the front door:
  #
  #   sthwalo.com/fin/subscription/success  ->  aosfin.com/subscription/success
  #
  # Done here rather than in public_html/fin/.htaccess so it ships with the build and cannot drift
  # from a file nobody in this repo can see. 301 because this move is permanent.
  #
  # NOTE FOR DEPLOY: delete public_html/fin/ on cPanel. While that directory has its own
  # .htaccess, the per-directory rules can take precedence over this one.
  RewriteRule ^fin/?(.*)$ https://aosfin.com/$1 [R=301,L]

  # Don't rewrite requests to the /api/ (Node.js contact API)
  RewriteRule ^api(/|$) - [L]

  # ── Prerendered pages ──────────────────────────────────────────────────────────────────
  #
  # Serve /about from /about/index.html WITHOUT redirecting. mod_dir would otherwise 301
  # /about -> /about/, which adds a hop to every internal link and leaves the canonical URL
  # disagreeing with the address bar. DirectorySlash Off stops that redirect; the rule below
  # does the mapping.
  #
  # The home page is home.html, not index.html: index.html is the SPA fallback for /blog and
  # every client route, so the home page's markup cannot live there without appearing under
  # every unprerendered URL too.
  #
  # Both degrade on purpose — a build made before the prerender step existed simply falls
  # through to the SPA below rather than 404-ing.
  RewriteCond %{DOCUMENT_ROOT}/home.html -f
  RewriteRule ^$ /home.html [L]

  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^([a-z0-9-]+)/?$ /$1/index.html [L]

  # Don't rewrite actual files or directories
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d

  # Send everything else to index.html for React Router
  RewriteRule . /index.html [L]
</IfModule>
